# API environment configuration
API_PORT=4000
JWT_SECRET=change-me-in-production
# Comma-separated allowed browser origins; leave empty to allow any origin (dev), or set explicitly in production
WEB_ORIGIN=
# Allow private/LAN origins automatically (true/false)
ALLOW_LAN_ORIGINS=true

# Optional: token for unauthenticated MFS/SMS forwarders posting to /api/billing/payments/sms/ingest.
# Without this, only callers with a verified JWT can ingest. Set a long random value in production.
# MFS_SMS_INGEST_TOKEN=change-me

# Optional: secret used to sign expiring public invoice PDF/HTML links (falls back to JWT_SECRET).
# INVOICE_SHARE_SECRET=change-me

# Optional: public portal URL used for walled-garden redirect rule provisioning
# WALLED_GARDEN_PORTAL_URL=https://izandesk.example.com/walled-garden

# Optional: geocoding provider for the GIS "find coordinates from address" action.
# Default: Nominatim (https://nominatim.openstreetmap.org/search). Override for an
# internal/offline geocoder. Requests are cached 24h and throttled to ~1/sec.
# GIS_GEOCODE_URL=https://nominatim.openstreetmap.org/search
