# API environment configuration
API_PORT=4000
JWT_SECRET=change-me-in-production
# Apply apps/api/migrations/*.sql at API boot (idempotent, advisory-locked).
# Leave unset when migrations run as a separate `pnpm --filter api migrate` step.
# MIGRATE_ON_START=true
# Comma-separated allowed browser origins; leave empty to allow any origin (dev), or set explicitly in production
WEB_ORIGIN=
# Allow private/LAN origins automatically (true/false)
ALLOW_LAN_ORIGINS=true
# Optional: loopback base URL used by the MCP action executor to re-enter this API.
# Defaults to http://127.0.0.1:${API_PORT}. Set this when the API runs in a container
# with a non-standard hostname or port mapping.
# MCP_API_BASE_URL=http://127.0.0.1:4000

# Optional: token for unauthenticated MFS/SMS forwarders posting to /api/billing/payments/sms/ingest.
# Without this, only callers with a verified JWT can ingest. Set a long random value in production.
# MFS_SMS_INGEST_TOKEN=change-me

# Optional: secret used to sign expiring public invoice PDF/HTML links (falls back to JWT_SECRET).
# INVOICE_SHARE_SECRET=change-me

# Set to true in real deployments to disable the well-known demo accounts.
# Only leave unset for the public demo environment.
# DISABLE_DEMO_ACCOUNTS=true

# When demo accounts are disabled, create one SUPER_ADMIN sign-in at boot.
# Prefer the bcrypt hash (no plaintext password in the container env/router config):
#   node -e "console.log(require('bcrypt').hashSync('YOUR_STRONG_PASSWORD',12))"
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_NAME=Administrator
# BOOTSTRAP_ADMIN_PASSWORD_HASH=$2b$12$...
# Alternative (hashed in memory at boot, but plaintext is visible in env/config):
# BOOTSTRAP_ADMIN_PASSWORD=change-me

# Real deployments fail to start unless JWT_SECRET is long and non-default,
# DB_PASSWORD is non-default, DISABLE_DEMO_ACCOUNTS=true, WEB_ORIGIN is explicit
# and ALLOW_LAN_ORIGINS=false. SECURITY_STRICT_MODE extends the same fatal checks
# to non-production environments (useful in staging/CI).
# SECURITY_STRICT_MODE=true
# Local demo only: explicitly allow the insecure known-accounts profile even
# when NODE_ENV=production. Never set this on a real deployment.
# SECURITY_ALLOW_INSECURE_DEMO=true

# Optional: public portal URL used for walled-garden redirect rule provisioning
# WALLED_GARDEN_PORTAL_URL=https://izandesk.example.com/walled-garden

# Optional: geocoding provider for the GIS "find coordinates from address" action.
# Default: Nominatim (https://nominatim.openstreetmap.org/search). Override for an
# internal/offline geocoder. Requests are cached 24h and throttled to ~1/sec.
# GIS_GEOCODE_URL=https://nominatim.openstreetmap.org/search

# Dedicated AES-256-GCM encryption keys for router/OLT/gateway/MFA secrets at rest
# (falls back to KYC_ENCRYPTION_KEYS or JWT_SECRET in local dev)
# SECRETS_ENCRYPTION_KEYS=v1:<base64-32-bytes>
# SECRETS_ENCRYPTION_ACTIVE_KEY_ID=v1
# SECRETS_ENCRYPTION_KEY=
# Rotation: add the new key id, point ACTIVE_KEY_ID at it, restart, then call
# POST /api/system/rotate-secrets (SUPER_ADMIN + MFA step-up). Keep the old key
# configured until the response reports no errors.

# Redis / BullMQ (disabled automatically when IZAN_LITE=true or REDIS_DISABLED=true)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_URL=

# Structured JSON logger level (fatal, error, warn, info, debug, silent)
LOG_LEVEL=info

# Optional default SMTP overrides (Settings -> Notifications takes precedence when set)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Optional global CA certificate PEM for strict RouterOS HTTPS/API TLS verification
# MIKROTIK_TLS_CA_CERT=
