# Copy to .env.local and adjust for your environment
NEXT_PUBLIC_API_URL=
INTERNAL_API_URL=http://localhost:4000
ALLOWED_DEV_ORIGINS=

# Optional: Fiber GIS Map (admin-only) settings
# The workbench is a single MapLibre GL map. One local style carries both
# basemaps: Esri World Imagery + the same OpenFreeMap OSM vector layers the
# Streets view uses, so satellite labels match street-view names/typography.
# Point any of these at internal/self-hosted endpoints for air-gapped use.
# NEXT_PUBLIC_GIS_BASEMAP_STYLE_URL=/gis-basemap.json
# Satellite imagery source baked into the style (Esri World Imagery default).
# NEXT_PUBLIC_GIS_SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
# Vector tile source (OpenFreeMap planet default) used by both basemaps' labels.
# NEXT_PUBLIC_GIS_VECTOR_TILE_URL=https://tiles.openfreemap.org/planet
# Initial map centre as "latitude,longitude". Default: 23.8103,90.4125 (Dhaka)
# NEXT_PUBLIC_GIS_CENTER=23.8103,90.4125
