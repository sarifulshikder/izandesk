# Copy to .env.local and adjust for your environment
NEXT_PUBLIC_API_URL=
INTERNAL_API_URL=http://localhost:4000
ALLOWED_DEV_ORIGINS=

# Optional: Fiber GIS Map (admin-only) settings
# Leaflet tile source — point at an internal tile server for offline/air-gapped use.
# Default: https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_GIS_TILE_URL=https://tiles.internal.example.com/{z}/{x}/{y}.png
# Initial map centre as "latitude,longitude". Default: 23.8103,90.4125 (Dhaka)
# NEXT_PUBLIC_GIS_CENTER=23.8103,90.4125
# Satellite tile source used by the map's Satellite toggle.
# Default: Esri World Imagery
# NEXT_PUBLIC_GIS_SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
# Label-only overlay over satellite imagery. Default: Esri reference labels
# (clean sans-serif, shown in white via CSS) — override for an internal tile server.
# NEXT_PUBLIC_GIS_SATELLITE_LABELS_URL=https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Reference/MapServer/tile/{z}/{y}/{x}
# Optional extra road overlay, disabled by default.
# NEXT_PUBLIC_GIS_SATELLITE_ROADS_URL=
