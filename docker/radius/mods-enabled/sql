# Rendered at container start by docker-compose (see the freeradius service).
# __POSTGRES_USER__ / __POSTGRES_PASSWORD__ / __POSTGRES_DB__ are replaced with
# the same values the Postgres service uses, so changing POSTGRES_PASSWORD in
# .env does not silently break RADIUS authentication.
sql {
    driver = "rlm_sql_postgresql"
    dialect = "postgresql"

    server = "izandesk-postgres"
    port = 5432
    login = "__POSTGRES_USER__"
    password = "__POSTGRES_PASSWORD__"
    radius_db = "__POSTGRES_DB__"

    acct_table1 = "radacct"
    acct_table2 = "radacct"
    postauth_table = "radpostauth"
    authcheck_table = "radcheck"
    groupcheck_table = "radgroupcheck"
    authreply_table = "radreply"
    groupreply_table = "radgroupreply"
    usergroup_table = "radusergroup"
    read_groups = yes
    read_clients = yes
    client_table = "nas"
    delete_stale_sessions = yes

    pool {
        start = 5
        min = 4
        max = 32
        spare = 3
        uses = 0
        retry_delay = 30
        lifetime = 0
        idle_timeout = 60
    }

    group_attribute = "SQL-Group"
    $INCLUDE ${modconfdir}/${.:name}/main/${dialect}/queries.conf
}
