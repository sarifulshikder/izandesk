# Public site / reverse proxy
CADDY_SITE_ADDRESS=:80
CADDY_UPSTREAM=http://localhost:3000
CADDY_ACME_EMAIL=

# Core services
API_PORT=4000
WEB_PORT=3000
JWT_SECRET=change-me-in-production
WEB_ORIGIN=
ALLOW_LAN_ORIGINS=true
NODE_ENV=production
# Production bootstrap guard: set all of these for a real deployment.
# DISABLE_DEMO_ACCOUNTS=true
# SECURITY_STRICT_MODE=true
# SECURITY_ALLOW_INSECURE_DEMO=false

# Database / cache
POSTGRES_DB=izandesk
POSTGRES_USER=izandesk_user
POSTGRES_PASSWORD=izandesk_secret_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://izandesk_user:izandesk_secret_password@postgres:5432/izandesk
REDIS_PORT=6379

# Web -> API
NEXT_PUBLIC_API_URL=
INTERNAL_API_URL=http://api:4000

# TR-069 / GenieACS (optional, enable compose profile: acs)
GENIEACS_URL=
GENIEACS_USER=
GENIEACS_PASS=
GENIEACS_MONGODB_CONNECTION_URL=mongodb://mongo:27017/genieacs
GENIEACS_UI_JWT_SECRET=change-me

# WireGuard hub
WG_INTERFACE=wg0
WG_HUB_PORT=51820
