# Public site / reverse proxy
CADDY_SITE_ADDRESS=:80
CADDY_UPSTREAM=http://localhost:3000
CADDY_ACME_EMAIL=

# Core services
API_PORT=4000
WEB_PORT=3000
# Apply apps/api/migrations/*.sql when the API starts (idempotent, advisory-locked).
MIGRATE_ON_START=true
# When moving a host-run dev API into Docker, copy JWT_SECRET from apps/api/.env
# so existing tokens keep validating; stored device secrets need SECRETS_ENCRYPTION_KEYS below.
JWT_SECRET=change-me-in-production
WEB_ORIGIN=
ALLOW_LAN_ORIGINS=true
NODE_ENV=production
# Production bootstrap guard: set all of these for a real deployment.
# DISABLE_DEMO_ACCOUNTS=true
# SECURITY_STRICT_MODE=true
# SECURITY_ALLOW_INSECURE_DEMO=false

# Bootstrap SUPER_ADMIN (required when DISABLE_DEMO_ACCOUNTS=true)
# Prefer the bcrypt hash; BOOTSTRAP_ADMIN_PASSWORD is accepted for local convenience.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_PASSWORD_HASH=
# BOOTSTRAP_ADMIN_PASSWORD=

# KYC file encryption (required in production/strict mode)
# Format: v1:<base64 32-byte key>,v2:<base64 32-byte key>
KYC_ENCRYPTION_KEYS=
KYC_ENCRYPTION_ACTIVE_KEY_ID=

# Dedicated AES-256-GCM encryption for stored device/gateway/MFA secrets.
# When moving from host-run dev to Docker dev, copy the key ring from the
# environment that encrypted the stored secrets (or the JWT_SECRET-derived
# dev key) — a different key makes router/gateway passwords undecryptable.
SECRETS_ENCRYPTION_KEYS=
SECRETS_ENCRYPTION_ACTIVE_KEY_ID=
# SECRETS_ENCRYPTION_KEY=

# Signed links / authenticated MFS SMS ingest
INVOICE_SHARE_SECRET=
MFS_SMS_INGEST_TOKEN=

# Database / cache
POSTGRES_DB=izandesk
POSTGRES_USER=izandesk_user
POSTGRES_PASSWORD=izandesk_secret_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://izandesk_user:izandesk_secret_password@postgres:5432/izandesk
REDIS_PORT=6379

# SQL-backed FreeRADIUS clients (dev/staging only)
# Leave the secret empty to skip seeding. The default hosts cover the
# RB1100AHx4's LAN interface, WireGuard address and WG-hub DNAT source.
RADIUS_NAS_HOSTS=10.5.50.1,10.77.0.2,172.18.0.3
RADIUS_NAS_SECRET=

# Web -> API
NEXT_PUBLIC_API_URL=
INTERNAL_API_URL=http://api:4000

# TR-069 / GenieACS (optional, enable compose profile: acs)
# From inside the API container, a standalone GenieACS publishing 7557 on the
# host is reachable at http://host.docker.internal:7557 (compose adds the alias).
GENIEACS_URL=
GENIEACS_USER=
GENIEACS_PASS=
GENIEACS_MONGODB_CONNECTION_URL=mongodb://mongo:27017/genieacs
GENIEACS_UI_JWT_SECRET=change-me

# WireGuard hub
WG_INTERFACE=wg0
WG_HUB_PORT=51820
