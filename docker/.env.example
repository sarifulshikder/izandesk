# Caddy / HTTPS reverse proxy (used by docker compose)
# For automatic HTTPS, set a public DNS name pointing to your server and forward ports 80/443.
# Example: CADDY_SITE_ADDRESS=izandesk.example.com
CADDY_SITE_ADDRESS=:80
# Caddy runs with host networking in docker-compose.yml, so localhost reaches host services
CADDY_UPSTREAM=http://localhost:3000
CADDY_ACME_EMAIL=admin@example.com

# WireGuard hub (plug-and-play overlay for MikroTik sites behind NAT/CGNAT and OLTs behind them)
# Set WG_HUB_ENDPOINT_HOST in IzanDesk (or via API/UI) to your server's public DNS/IP reachable by remote routers.
WG_INTERFACE=wg0
WG_HUB_PORT=51820
# WG_CONFIG_DIR can override where IzanDesk API writes wg hub config (default: docker/wg-hub/config relative to project)
